# ─── Server ───────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────
# Get a free PostgreSQL DB at https://neon.tech or https://render.com
DATABASE_URL=postgresql://user:password@host:5432/hirebound_db

# ─── JWT ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_min_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_64_chars
JWT_REFRESH_EXPIRES_IN=7d

# ─── SMTP / Email ─────────────────────────────────────────
# Works with Gmail, SendGrid, Mailgun, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="HireBound Platform <noreply@hirebound.gov.in>"

# ─── Frontend ─────────────────────────────────────────────
# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,https://hirebound-lime.vercel.app

# ─── File Upload ──────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
